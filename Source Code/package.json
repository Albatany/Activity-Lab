{
  "name": "activity-lab-synthetic",
  "displayName": "Activity Lab (Synthetic)",
  "description": "Labeled synthetic VS Code editor tests with local additions/deletions counters; does not claim WakaTime stats or coding hours.",
  "version": "3.0.0",
  "publisher": "localdev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "synthetic",
    "activity",
    "editor",
    "extension-testing",
    "languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:activityLab.start",
    "onCommand:activityLab.stop",
    "onCommand:activityLab.status"
  ],
  "contributes": {
    "commands": [
      {
        "command": "activityLab.start",
        "title": "Activity Lab: Start Synthetic Session"
      },
      {
        "command": "activityLab.stop",
        "title": "Activity Lab: Stop Session"
      },
      {
        "command": "activityLab.status",
        "title": "Activity Lab: Show Session Status"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js",
    "test": "node tests/smoke-test.js && node tests/patterns-test.js && node tests/mock-vscode-integration.js"
  }
}
