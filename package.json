{
  "name": "activity-lab-synthetic",
  "displayName": "Activity Lab",
  "description": "Simulate edits in isolated VS Code files using one language, a saved selection or a professional mode. Apply each edit at once or watch the code appear one character at a time.",
  "version": "4.1.1",
  "publisher": "localdev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "synthetic",
    "activity",
    "editor",
    "extension-testing",
    "languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:activityLab.start",
    "onCommand:activityLab.stop",
    "onCommand:activityLab.status"
  ],
  "contributes": {
    "commands": [
      {
        "command": "activityLab.start",
        "title": "Activity Lab: Start Session"
      },
      {
        "command": "activityLab.stop",
        "title": "Activity Lab: Stop Session"
      },
      {
        "command": "activityLab.status",
        "title": "Activity Lab: Show Status"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js",
    "test": "node tests/smoke-test.js && node tests/patterns-test.js && node tests/modes-and-naming-test.js && node tests/mock-vscode-integration.js",
    "build": "python scripts/build.py"
  },
  "author": {
    "name": "Albatany"
  },
  "icon": "media/activity-lab.png"
}
