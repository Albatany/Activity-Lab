{
  "name": "activity-lab-synthetic",
  "displayName": "Activity Lab  |  by Albatany",
  "description": "Simulasi aktivitas editor dengan 32 mode teknologi, 141 profil bahasa, nama proyek kustom, dan laporan lokal. © Albatany 2026.",
  "version": "4.0.0",
  "publisher": "localdev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "synthetic",
    "activity",
    "editor",
    "extension-testing",
    "languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:activityLab.start",
    "onCommand:activityLab.stop",
    "onCommand:activityLab.status"
  ],
  "contributes": {
    "commands": [
      {
        "command": "activityLab.start",
        "title": "Activity Lab: Mulai Simulasi"
      },
      {
        "command": "activityLab.stop",
        "title": "Activity Lab: Hentikan Simulasi"
      },
      {
        "command": "activityLab.status",
        "title": "Activity Lab: Lihat Status"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js",
    "test": "node tests/smoke-test.js && node tests/patterns-test.js && node tests/modes-and-naming-test.js && node tests/mock-vscode-integration.js"
  },
  "author": {
    "name": "Albatany"
  }
}
